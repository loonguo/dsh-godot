extends Node2D
## Starter main script — generated by dsh-godot `godot_project_init`.
##
## What a model should know:
## - `_ready()` prints one deterministic line (`STARTER_READY ...`) so a headless
##   run can assert the scene actually booted:
##       godot --headless --path <proj> --quit-after 5
## - The autoload `Bridge` (res://addons/dsh_bridge/dsh_bridge.gd) is inert
##   unless the game is launched with `-- --dsh-bridge=host:port`.
## - `dsh_probe()` exists as a bridge-friendly helper: call it with
##       godot_bridge { session, command: "node_call",
##                      args: { path: "/root/Main", method: "dsh_probe" } }
##   It returns JSON-safe values only, so the answer survives the wire.

const READY_LINE := "STARTER_READY"

## Pixels per second for the marker when ui_left/ui_right is held.
var speed := 180.0

@onready var label: Label = $Label
@onready var marker: ColorRect = $Marker


func _ready() -> void:
	print("%s name=%s scene=%s" % [
		READY_LINE,
		ProjectSettings.get_setting("application/config/name", ""),
		scene_file_path,
	])
	label.text = "%s — dsh-godot starter" % ProjectSettings.get_setting("application/config/name", "project")


func _process(delta: float) -> void:
	# Movement driven by real Input actions: the bridge `action` command
	# (Input.action_press/release) feeds straight into this.
	var direction := 0.0
	if Input.is_action_pressed("ui_right"):
		direction += 1.0
	if Input.is_action_pressed("ui_left"):
		direction -= 1.0
	if direction != 0.0:
		marker.position.x = clampf(marker.position.x + direction * speed * delta, 0.0, 600.0)


## Bridge helper: `node_call {path:"/root/Main", method:"dsh_probe"}`.
## Returns JSON-safe values (numbers/strings/Arrays/Dictionaries) only.
func dsh_probe() -> Dictionary:
	return {
		"name": str(name),
		"frames": Engine.get_process_frames(),
		"marker_x": marker.position.x,
		"speed": speed,
	}


## Example mutator for `node_set`/`node_call` workflows in a scaffolded project.
func dsh_set_speed(value: float) -> float:
	speed = value
	return speed
